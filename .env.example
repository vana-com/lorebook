# Copy to .env.local and register the derived app identity in Vana Account.

# Your app's private key. Server-side only — never expose in the browser.
VANA_PRIVATE_KEY=0x...

# The canonical origin registered for this app. Use the deployed HTTPS origin
# in Vercel and localhost for local development. For phone E2E, override this
# in .env.local with the exact LAN-reachable dev-server URL (for example, http://192.168.x.x:3010).
APP_URL=http://localhost:3010
