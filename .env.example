# Copy to .env.local and fill in during Step 2 (Create an app identity).
# Both values come from account.vana.org/developers.

# Your app's private key. Server-side only — never expose in the browser.
VANA_PRIVATE_KEY=0x...

# The exact origin your app runs on. Must match the App URL you registered.
# Local dev for this app:
APP_URL=http://localhost:3010
